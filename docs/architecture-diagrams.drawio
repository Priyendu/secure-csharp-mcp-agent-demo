  <diagram id="authflow" name="03-Security Auth Flow">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Title -->
        <mxCell id="title3" value="Secure MCP - Authentication & Authorization Flow" style="text;html=1;strokeColor=none;fillColor=none;spacingTop=-4;fontSize=18;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1300" height="35" as="geometry"/>
        </mxCell>
        
        <!-- Client Swimlane -->
        <mxCell id="swimClient" value="SecureMcpClientAgent" style="swimlane;startSize=30;horizontal=0;fillColor=#e8f5e9;strokeColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="180" height="980" as="geometry"/>
        </mxCell>
        
        <!-- Server Swimlane -->
        <mxCell id="swimServer" value="SecureMcpServer" style="swimlane;startSize=30;horizontal=0;fillColor=#e3f2fd;strokeColor=#0d47a1;" vertex="1" parent="1">
          <mxGeometry x="240" y="70" width="380" height="980" as="geometry"/>
        </mxCell>
        
        <!-- Services Swimlane -->
        <mxCell id="swimServices" value="Services & Middleware" style="swimlane;startSize=30;horizontal=0;fillColor=#fff3e0;strokeColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="640" y="70" width="320" height="980" as="geometry"/>
        </mxCell>
        
        <!-- Step 1 - Client requests token -->
        <mxCell id="step1" value="1. POST /auth/token&#10;{ ClientId: &quot;demo-client&quot;,&#10;  Scopes: [&quot;mcp:tools&quot;] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;fontSize=10;" vertex="1" parent="swimClient">
          <mxGeometry x="10" y="60" width="160" height="65" as="geometry"/>
        </mxCell>
        
        <!-- Arrow 1 -->
        <mxCell id="arr1" value="" style="endArrow=classic;html=1;strokeColor=#1b5e20;strokeWidth=2;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Step 2 - Token Service -->
        <mxCell id="step2" value="2. DemoTokenService.GenerateToken()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;fontSize=10;" vertex="1" parent="swimServices">
          <mxGeometry x="10" y="60" width="300" height="35" as="geometry"/>
        </mxCell>
        
        <!-- Arrow 2 -->
        <mxCell id="arr2" value="" style="endArrow=classic;html=1;strokeColor=#e65100;strokeWidth=2;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Step 3 - Return JWT -->
        <mxCell id="step3" value="3. 200 OK&#10;{ access_token: &quot;eyJ...&quot; }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;fontSize=10;" vertex="1" parent="swimClient">
          <mxGeometry x="10" y="145" width="160" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Step 4 - SSE Connection -->
        <mxCell id="step4" value="4. GET /mcp/sse&#10;Authorization: Bearer eyJ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;fontSize=10;" vertex="1" parent="swimClient">
          <mxGeometry x="10" y="220" width="160" height="55" as="geometry"/>
        </mxCell>
        
        <mxCell id="arr3" value="" style="endArrow=classic;html=1;strokeColor=#0d47a1;strokeWidth=2;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Step 5 - /mcp/sse handler -->
        <mxCell id="step5" value="5. /mcp/sse Handler&#10;• Extract Bearer token&#10;• Validate JWT&#10;• Check scope mcp:tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;fontSize=10;" vertex="1" parent="swimServer">
          <mxGeometry x="10" y="220" width="180" height="80" as="geometry"/>
        </mxCell>
        
        <mxCell id="arr4" value="" style="endArrow=classic;html=1;strokeColor=#1565c0;strokeWidth=2;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Step 6 - Auth failure paths -->
        <mxCell id="step6" value="6a. 401 Unauthorized&#10;(no/invalid token)&#10;&#10;6b. 403 Forbidden&#10;(missing mcp:tools scope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;fontSize=9;" vertex="1" parent="swimServer">
          <mxGeometry x="200" y="220" width="170" height="85" as="geometry"/>
        </mxCell>
        
        <!-- Success path -->
        <mxCell id="step7" value="7. Success → SSE stream&#10;+ Audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;fontSize=10;" vertex="1" parent="swimClient">
          <mxGeometry x="10" y="320" width="160" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="arr5" value="" style="endArrow=classic;html=1;strokeColor=#1b5e20;strokeWidth=2;" edge="1" parent="1" source="step7" target="step8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Step 8 - Tool call -->
        <mxCell id="step8" value="8. POST /mcp/messages&#10;{ jsonrpc: &quot;2.0&quot;,&#10;  method: &quot;tools/call&quot;,&#10;  params: { name, arguments } }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;fontSize=9;" vertex="1" parent="swimClient">
          <mxGeometry x="10" y="400" width="160" height="80" as="geometry"/>
        </mxCell>
        
        <mxCell id="arr6" value="" style="endArrow=classic;html=1;strokeColor=#0d47a1;strokeWidth=2;" edge="1" parent="1" source="step8" target="step9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Step 9 - Messages endpoint -->
        <mxCell id="step9" value="9. /mcp/messages Handler&#10;• JWT validation&#10;• Scope enforcement&#10;• AuditLogger.LogToolCall()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;fontSize=10;" vertex="1" parent="swimServer">
          <mxGeometry x="10" y="400" width="360" height="70" as="geometry"/>
        </mxCell>
        
        <mxCell id="arr7" value="" style="endArrow=classic;html=1;strokeColor=#e65100;strokeWidth=2;" edge="1" parent="1" source="step9" target="step10">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Step 10 - Tool dispatch -->
        <mxCell id="step10" value="10. HandleToolCall()&#10;switch on tool name&#10;• get_release_status&#10;• get_dependencies&#10;• check_security_vulnerabilities&#10;• approve_release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;fontSize=9;" vertex="1" parent="swimServices">
          <mxGeometry x="10" y="400" width="300" height="100" as="geometry"/>
        </mxCell>
        
        <!-- Step 11 - approve failure note -->
        <mxCell id="step11" value="11. approve_release&#10;→ Requires mcp:tools:release&#10;→ Returns 403 (demo negative test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;fontSize=9;lineHeight=1.2;" vertex="1" parent="swimServer">
          <mxGeometry x="10" y="500" width="170" height="55" as="geometry"/>
        </mxCell>
        
        <!-- Return result -->
        <mxCell id="step12" value="12. JSON-RPC 2.0 Result&#10;or Error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;fontSize=10;" vertex="1" parent="swimClient">
          <mxGeometry x="10" y="520" width="160" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Legend box -->
        <mxCell id="legend3" value="Negative Test Cases Documented:&#10;• 401 on missing/invalid token&#10;• 403 on missing required scope&#10;• approve_release fails without release scope&#10;&#10;All flows logged via SecurityAuditLogger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#424242;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="150" width="320" height="140" as="geometry"/>
        </mxCell>
        
        <!-- Color key -->
        <mxCell id="keyGreen" value="Green = Client Actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#1b5e20;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1000" y="310" width="150" height="25" as="geometry"/>
        </mxCell>
        
        <mxCell id="keyBlue" value="Blue = Server Endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#0d47a1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1000" y="345" width="150" height="25" as="geometry"/>
        </mxCell>
        
        <mxCell id="keyOrange" value="Orange = Business Logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1000" y="380" width="150" height="25" as="geometry"/>
        </mxCell>
        
        <mxCell id="keyRed" value="Red = Error / Negative Path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1000" y="415" width="150" height="25" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
