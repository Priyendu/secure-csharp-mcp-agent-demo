<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SecureMcpDesktopDemo</RootNamespace>
    <AssemblyName>SecureMcpDesktopDemo</AssemblyName>
    <!-- Single-file friendly for demo distribution if desired -->
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup><!-- No external NuGet packages required for the core demo.
         Uses built-in System.Text.Json, HttpClient, Process, etc. -->
  
    <ProjectReference Include="..\SecureMcpShared\SecureMcpShared.csproj" />
  </ItemGroup>

</Project>
