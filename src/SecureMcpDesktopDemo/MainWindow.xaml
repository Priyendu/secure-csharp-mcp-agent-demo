<Window x:Class="SecureMcpDesktopDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Secure MCP Agent - C# Desktop E2E Demo" 
        Height="860" Width="1280"
        MinWidth="1100" MinHeight="720"
        Background="#020617" Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Server controls -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="Auto"/> <!-- Bottom status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#67E8F9">
                <Run>Secure C# MCP Agent</Run>
            </TextBlock>
            <TextBlock Margin="12,4,0,0" FontSize="13" Foreground="#64748B">
                End-to-End Desktop Demo (WPF + .NET 8)
            </TextBlock>
            <TextBlock Margin="20,4,0,0" FontSize="11" Foreground="#475569" VerticalAlignment="Center">
                All security concepts demonstrated from a single native C# UI
            </TextBlock>
        </StackPanel>

        <!-- Server + Quick Actions -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MCP Server:" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Border x:Name="ServerStatusBorder" Background="#334155" CornerRadius="4" Padding="8,2">
                        <TextBlock x:Name="ServerStatusText" Text="Stopped" Foreground="#FCD34D"/>
                    </Border>
                    <TextBlock x:Name="ServerUrlText" Text="https://localhost:5001" Margin="10,0,0,0" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="StartServerBtn" Content="▶ Start Secure MCP Server" 
                            Click="StartServer_Click" Style="{StaticResource PrimaryButton}" Margin="4"/>
                    <Button x:Name="StopServerBtn" Content="■ Stop Server" 
                            Click="StopServer_Click" Style="{StaticResource SecondaryButton}" Margin="4"/>
                    <Button Content="Trust Dev Cert" Click="TrustDevCert_Click" Style="{StaticResource SecondaryButton}" Margin="4"/>
                    <Button Content="Clear All Logs" Click="ClearLogs_Click" Style="{StaticResource SecondaryButton}" Margin="4"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Solution Root:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SolutionRootBox" Width="320" Text="C:\Users\priye\secure-csharp-mcp-agent-demo" 
                             FontSize="11" ToolTip="Path containing the .sln (used to launch the server project)"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/> <!-- Controls -->
                <ColumnDefinition Width="*"/>   <!-- Main demo area -->
                <ColumnDefinition Width="320"/> <!-- Logs / Raw -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Scenarios + Tokens + Manual -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="DEMO SCENARIOS" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" Foreground="#67E8F9"/>

                    <Button Content="1. Ready (AnalyzerService 2.4.1) — Standard Token → Expect 403 on approve" 
                            Click="Scenario_Ready_Click" Style="{StaticResource ScenarioButton}"/>
                    <Button Content="2. Approve (AnalyzerService 2.4.1) — Privileged Token → Full success" 
                            Click="Scenario_Approve_Click" Style="{StaticResource ScenarioButton}"/>
                    <Button Content="3. Blocked (PaymentGateway 5.8.0) — Has CVE, regardless of token" 
                            Click="Scenario_Blocked_Click" Style="{StaticResource ScenarioButton}"/>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="CUSTOM QUERY" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="QueryBox" Text="Can we release AnalyzerService version 2.4.1?" 
                             Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <CheckBox x:Name="PrivilegedCheck" Content="Use Privileged token (mcp:tools:release + secret)" Margin="0,8,0,6"/>

                    <Button Content="Run Full Automated Review" Click="RunFullReview_Click" 
                            Style="{StaticResource PrimaryButton}" Margin="0,4,0,2"/>

                    <Button Content="Run Step-by-Step (manual control)" Click="RunStepByStep_Click" 
                            Style="{StaticResource SecondaryButton}" Margin="0,2"/>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="TOKEN ACQUISITION" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                    <Button Content="Acquire STANDARD Token (mcp:tools only)" 
                            Click="AcquireStandardToken_Click" Style="{StaticResource SecondaryButton}" Margin="0,2"/>
                    <Button Content="Acquire PRIVILEGED Token (with demo secret)" 
                            Click="AcquirePrivilegedToken_Click" Style="{StaticResource PrimaryButton}" Margin="0,2"/>

                    <Border Background="#1E2937" Padding="8" Margin="0,8,0,4" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Current Token" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock x:Name="CurrentTokenText" Text="(none)" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" MaxHeight="80"/>
                            <TextBlock x:Name="CurrentScopesText" Text="Scopes: -" FontSize="10" Foreground="#67E8F9" Margin="0,4,0,0"/>
                            <Button Content="Decode JWT (show claims)" Click="DecodeToken_Click" Margin="0,6,0,0" 
                                    Style="{StaticResource SecondaryButton}" Padding="6,3"/>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,6"/>

                    <TextBlock Text="MANUAL TOOL CALL" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ManualToolCombo" SelectedIndex="0" Margin="0,2">
                        <ComboBoxItem Content="get_release_status"/>
                        <ComboBoxItem Content="get_dependencies"/>
                        <ComboBoxItem Content="check_security_vulnerabilities"/>
                        <ComboBoxItem Content="approve_release"/>
                    </ComboBox>
                    <TextBox x:Name="ManualComponentBox" Text="AnalyzerService" Margin="0,4,0,2"/>
                    <TextBox x:Name="ManualVersionBox" Text="2.4.1" Margin="0,2"/>
                    <Button Content="Call Tool with Current Token" Click="ManualToolCall_Click" 
                            Style="{StaticResource SecondaryButton}" Margin="0,4"/>
                </StackPanel>
            </Border>

            <!-- CENTER: Review results + Live Trace -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Intent + Verdict -->
                        <RowDefinition Height="*"/>   <!-- Tool Trace -->
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="RELEASE REVIEW FLOW" FontWeight="Bold" FontSize="12" Foreground="#67E8F9" Margin="0,0,0,6"/>

                        <!-- Intent -->
                        <Border Background="#1E2937" Padding="10" CornerRadius="4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Parsed Intent" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="IntentComponent" Text="-" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock x:Name="IntentVersion" Text="-" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock x:Name="IntentSource" Text="Source: -" FontSize="11"/>
                                    <TextBlock x:Name="IntentConfidence" Text="Confidence: -" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Verdict -->
                        <Border x:Name="VerdictBorder" Background="#1E2937" Padding="12" CornerRadius="6" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="VERDICT" FontSize="10" Foreground="#64748B"/>
                                <TextBlock x:Name="VerdictText" Text="Awaiting review..." FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="SummaryText" Text="Run a scenario or custom query to see the full secure flow." 
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="RecommendationText" Text="" FontStyle="Italic" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Live Tool Trace -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="LIVE TOOL TRACE (each call goes through the authenticated MCP server)" 
                                   FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                            <ItemsControl x:Name="TraceItemsControl" ItemsSource="{Binding ToolTraces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" 
                                                Padding="8" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Tool}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding HttpStatusLabel}" FontFamily="Consolas" FontSize="11" 
                                                               Foreground="{Binding StatusColor}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" 
                                                           TextWrapping="Wrap" Margin="12,0,0,0" FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: Protocol + Server Logs -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TabControl>
                        <TabItem Header="Protocol Log">
                            <TextBox x:Name="ProtocolLogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                     FontFamily="Consolas" FontSize="10" Background="#020617" Foreground="#CBD5E1"
                                     TextWrapping="Wrap" AcceptsReturn="True"/>
                        </TabItem>
                        <TabItem Header="Server Log">
                            <TextBox x:Name="ServerLogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                     FontFamily="Consolas" FontSize="10" Background="#020617" Foreground="#94A3B8"
                                     TextWrapping="Wrap" AcceptsReturn="True"/>
                        </TabItem>
                        <TabItem Header="Raw Last Response">
                            <TextBox x:Name="RawResponseBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                     FontFamily="Consolas" FontSize="10" Background="#020617" Foreground="#E0F2FE"
                                     TextWrapping="Wrap" AcceptsReturn="True"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom explanatory bar -->
        <Border Grid.Row="3" Background="#0F172A" Padding="10" CornerRadius="4" Margin="0,8,0,0">
            <TextBlock FontSize="10" Foreground="#64748B" TextWrapping="Wrap">
                <Run FontWeight="SemiBold">Key concepts demonstrated here (all from this single C# WPF app):</Run>
                <LineBreak/>
                • JWT + scope-based authorization enforced server-side (mcp:tools vs mcp:tools:release)&#160;&#160;
                • Demo-only token issuer that requires a secret for privileged scope&#160;&#160;
                • Negative auth path (403) visible when using insufficient scope&#160;&#160;
                • Same 4 MCP tools used by console client, web agent, and now this native desktop client&#160;&#160;
                • Local deterministic parser (agent side) vs. authoritative data + policy on the MCP server
            </TextBlock>
        </Border>
    </Grid>
</Window>

